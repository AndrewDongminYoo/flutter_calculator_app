{
  "version": "0.2",
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "import": [
    "https://raw.githubusercontent.com/AndrewDongminYoo/quality-configs/v0.8.0/configs/cspell.config.yaml",
    "https://raw.githubusercontent.com/AndrewDongminYoo/quality-configs/v0.8.0/configs/cspell/vgv.config.yaml"
  ],
  "dictionaries": ["lorem", "flutter", "project-words", "plaything"],
