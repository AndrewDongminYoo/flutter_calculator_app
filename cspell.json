    {
      "name": "project-words",
      "path": "./.cspell/flutter.txt"
    }
  ],
  "ignoreWords": [],
  "ignorePaths": [".gitignore", "**/project.pbxproj"],
  "useGitignore": true,
  "allowCompoundWords": true,
  "words": []
}
